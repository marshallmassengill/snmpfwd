[Unit]
Description=SNMP Proxy Forwarder - server
Documentation=https://github.com/marshallmassengill/snmpfwd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/snmpfwd-server --config-file=/etc/snmpfwd/server.conf --logging-method=stderr --log-level=info
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15s

# Filesystem hardening. DynamicUser=yes already implies a lot of the
# below, but being explicit survives systemd defaults changes.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Binding to 161/udp (the default SNMP agent port) requires
# CAP_NET_BIND_SERVICE. Comment both lines out if you only bind to
# unprivileged ports (>= 1024).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Transparent-proxy mode (snmp-transport-options: transparent-proxy)
# additionally needs CAP_NET_ADMIN so snmpfwd-server can call
# setsockopt(IP_TRANSPARENT) on its listening socket and receive
# iptables TPROXY-redirected packets whose original destination is a
# non-local IP. Replace the two lines above with the two below if your
# deployment uses transparent-proxy. See `conf/systemd/README.rst` for
# the accompanying iptables / ip rule / ip route setup.
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
# AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
