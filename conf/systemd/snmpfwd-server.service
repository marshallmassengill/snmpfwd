[Unit]
Description=SNMP Proxy Forwarder - server
Documentation=https://github.com/marshallmassengill/snmpfwd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/snmpfwd-server --config-file=/etc/snmpfwd/server.conf --logging-method=stderr --log-level=info
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15s

# Filesystem hardening. DynamicUser=yes already implies a lot of the
# below, but being explicit survives systemd defaults changes.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Binding to 161/udp (the default SNMP agent port) requires
# CAP_NET_BIND_SERVICE. Comment both lines out if you only bind to
# unprivileged ports (>= 1024).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
